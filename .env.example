# Construction Change-Order Extraction Pipeline Environment Configuration

# OpenAI API Settings
OPENAI_API_KEY=sk-placeholder-do-not-commit-real-keys
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60.0

# Document & Processing Constraints
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB limit
MAX_PDF_PAGES=50               # Max pages per document to prevent resource exhaustion
OCR_MIN_CHAR_DENSITY=50        # Min extracted chars per page before triggering OCR fallback

# OCR Binary Configuration (Optional if installed in system PATH)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=

# Server & Logging Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
